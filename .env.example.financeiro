# Copie este arquivo para .env e preencha com os valores reais.
# NUNCA commite o arquivo .env (já está no .gitignore).

# Conexão com o banco de dados SQL Server
DB_SERVER=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Credenciais de login do administrador do dashboard
USUARIO_MASTER=
SENHA_MASTER=

# Mapeamento de usuário (centro de custo) para senha.
# Opção A: cole o JSON inteiro numa linha só aqui:
# USUARIOS_CC={"1011": ["xxxx"], "1012": ["xxxx"]}
#
# Opção B (recomendada para o dicionário grande): aponte para um arquivo local
# USUARIOS_CC_FILE=./usuarios_cc.json
